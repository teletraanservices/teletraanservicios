# Reference for Render Web Service environment variables.
# Configure these in Render's Environment settings; Django does not load .env files.
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=your-service.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-service.onrender.com
DJANGO_HSTS_SECONDS=0

# Use Render PostgreSQL's Internal Database URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Required for password recovery on Render Free.
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=Teletraan Services <no-reply@your-verified-domain.cl>

# Optional persistent media storage (S3-compatible).
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_QUERYSTRING_AUTH=true

# SMTP alternative for hosting plans that allow outbound SMTP.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
