DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=your-service.up.railway.app,www.your-domain.cl
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-service.up.railway.app,https://www.your-domain.cl
DATABASE_URL=postgresql://user:password@host:5432/database
DJANGO_HSTS_SECONDS=0
SMTP_HOST=smtp.your-provider.cl
SMTP_PORT=587
SMTP_USERNAME=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@your-domain.cl
